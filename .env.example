# Supabase Free Tier Configuration (Optional, in-memory fallback included)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Resend API Key for sending real emails to xxxxx@nitpy.ac.in (Free 3,000 emails/month at resend.com)
# If not provided, the server outputs the OTP to terminal and response for easy local testing.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=NITPy Hostel <onboarding@resend.dev>
